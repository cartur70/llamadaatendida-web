---
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/layout/Nav.astro";
import Footer from "../../components/layout/Footer.astro";
import AtnHero from "../../components/sections/atn/AtnHero.astro";
import AtnHibrido from "../../components/sections/atn/AtnHibrido.astro";
import AtnCanales from "../../components/sections/atn/AtnCanales.astro";
import AtnFlujo from "../../components/sections/atn/AtnFlujo.astro";
import AtnComparativa from "../../components/sections/atn/AtnComparativa.astro";
import AtnCotizador from "../../components/sections/atn/AtnCotizador.astro";
import AtnCrossSell from "../../components/sections/atn/AtnCrossSell.astro";
import AtnFaq from "../../components/sections/atn/AtnFaq.astro";
import AtnCtaFinal from "../../components/sections/atn/AtnCtaFinal.astro";
import { BRAND } from "../../data/brand.js";
import { ATENCION_247 } from "../../data/atencion-24-7.js";
import ogSourceImage from "../../assets/img/mujer-call-center.jpg";

const ogImageResult = await getImage({ src: ogSourceImage, format: "jpg", width: 1200, height: 630 });
// Mismo criterio que en /soluciones/web-conversion: dominio real de la marca
// (BRAND.url) en vez del dominio de staging de Cloudflare Pages del brief,
// para mantener canonical/OG consistentes con el resto del sitio.
const pageURL = new URL("/soluciones/atencion-24-7", BRAND.url).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Atención al cliente 24/7 con IA y agentes humanos",
  name: "Atención al Cliente 24/7",
  description: ATENCION_247.seo.description,
  provider: {
    "@type": "Organization",
    name: BRAND.legalName,
    url: BRAND.url,
    telephone: BRAND.contact.phone,
  },
  areaServed: "ES",
  url: pageURL,
};
---

<BaseLayout title={ATENCION_247.seo.title} description={ATENCION_247.seo.description} ogImage={ogImageResult.src} schema={serviceSchema}>
  <Nav />
  <main id="main">
    <AtnHero />
    <AtnHibrido />
    <AtnCanales />
    <AtnFlujo />
    <AtnComparativa />
    <AtnCotizador />
    <AtnCrossSell />
    <AtnFaq />
    <AtnCtaFinal />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { safe, onReady } from "../../scripts/utils.js";
  import { initReveal } from "../../scripts/effects/reveal.js";

  onReady(() => safe(initReveal, "initReveal"));
</script>
