---
import { BRAND } from "../../data/brand.js";
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import logo from "../../assets/img/logo.webp";
import { Image } from "astro:assets";

const path = Astro.url.pathname;
const isActive = (href) => href !== "#" && (path === href || (href !== "/" && path.startsWith(href)));
const isDropdownActive = (item) => item.dropdown?.some((child) => isActive(child.href));
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label={`${BRAND.name} — inicio`}>
      <Image src={logo} alt={BRAND.name} />
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      {BRAND.nav.map((item) =>
        item.dropdown ? (
          <div class="nav-dropdown">
            <button
              class:list={["nav-link", "nav-dropdown-trigger", { "is-active": isDropdownActive(item) }]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <Icon name="chevron-down" class="nav-dropdown-caret" />
            </button>
            <div class="nav-dropdown-menu">
              <div class="nav-dropdown-menu-inner">
                {item.dropdown.map((child) => (
                  <a href={child.href} class:list={["nav-dropdown-item", { "is-active": isActive(child.href) }]}>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={["nav-link", { "is-active": isActive(item.href) }]}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener" : undefined}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="nav-actions">
      <Button href="/contacto" size="sm" variant="primary" class="hero-actions-desktop">
        {BRAND.ctaPrimary}
      </Button>
      <button class="nav-burger" data-menu-toggle aria-label="Abrir menú" aria-expanded="false">
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" data-mobile-menu>
  {BRAND.nav.map((item) =>
    item.dropdown ? (
      <div class="mobile-dropdown" data-mobile-dropdown>
        <button
          class:list={["mobile-dropdown-toggle", { "is-active": isDropdownActive(item) }]}
          data-dropdown-toggle
          aria-expanded="false"
        >
          {item.label}
          <Icon name="chevron-down" class="mobile-dropdown-caret" />
        </button>
        <div class="mobile-dropdown-panel" data-dropdown-panel>
          <div>
            {item.dropdown.map((child) => (
              <a href={child.href} class:list={{ "is-active": isActive(child.href) }}>{child.label}</a>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <a
        href={item.href}
        class:list={{ "is-active": isActive(item.href) }}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener" : undefined}
      >
        {item.label}
      </a>
    )
  )}
  <Button href="/contacto" variant="primary">{BRAND.ctaPrimary}</Button>
</div>

<script>
  import { safe, onReady } from "../../scripts/utils.js";
  import { initNav } from "../../scripts/effects/nav.js";

  onReady(() => safe(initNav, "initNav"));
</script>

<style>
  .hero-actions-desktop { display: none; }
  @media (min-width: 620px) {
    .hero-actions-desktop { display: inline-flex; }
  }
</style>
