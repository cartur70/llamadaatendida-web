---
import { TECNOLOGIA } from "../../../data/tecnologia.js";
import { BRAND } from "../../../data/brand.js";
import Icon from "../../ui/Icon.astro";
import Button from "../../ui/Button.astro";
import Photo from "../../ui/Photo.astro";
import heroPhoto from "../../../assets/img/proceso-tecnologia.jpg";

const { hero } = TECNOLOGIA;
---

<section class="hero">
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="reveal">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1 class="h1 hero-title">{hero.title}</h1>
        <p class="lead hero-sub">{hero.subtitle}</p>

        <div class="hero-actions">
          <Button href="#informacion" variant="primary" icon="arrow-right">{BRAND.ctaPrimary}</Button>
          <Button href="#asi-se-configura" variant="ghost">Ver cómo se configura</Button>
        </div>
      </div>

      <div class="hero-visual reveal" style="transition-delay:.15s">
        <div class="hero-photo-frame">
          <Photo
            src={heroPhoto}
            alt="Fibras ópticas iluminadas con destellos naranjas y azules, imagen de la tecnología propia de la plataforma"
            eager
            quality={85}
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>

        <div class="tec-hero-chip glass-card">
          <Icon name="bolt" />
          {hero.chip}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { safe, onReady } from "../../../scripts/utils.js";
  import { initMagnetic } from "../../../scripts/effects/magnetic.js";

  onReady(() => safe(initMagnetic, "initMagnetic"));
</script>
