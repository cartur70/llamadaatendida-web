---
import { WEB_CONVERSION } from "../../../data/web-conversion.js";
import Button from "../../ui/Button.astro";

const { ctaFinal } = WEB_CONVERSION;
---

<section class="section" id="auditoria">
  <div class="container">
    <div class="wc-cta-final reveal">
      <span class="eyebrow" style="color:var(--accent-ink);opacity:.75;">Auditoría gratuita</span>
      <h2 class="h2">{ctaFinal.title}</h2>
      <p class="lead">{ctaFinal.subtitle}</p>

      <form class="wc-cta-form" data-contact-form novalidate>
        <div class="form-grid two">
          <div class="field">
            <label for="wc-nombre">Nombre y apellidos *</label>
            <input id="wc-nombre" name="nombre" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="wc-negocio">Nombre del negocio *</label>
            <input id="wc-negocio" name="negocio" type="text" required autocomplete="organization" />
          </div>
        </div>

        <div class="form-grid two" style="margin-top:1.1rem;">
          <div class="field">
            <label for="wc-email">Email *</label>
            <input id="wc-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="wc-telefono">Teléfono</label>
            <input id="wc-telefono" name="telefono" type="tel" autocomplete="tel" />
          </div>
        </div>

        <div class="field" style="margin-top:1.1rem;">
          <label for="wc-url">URL de tu web actual (opcional)</label>
          <input id="wc-url" name="url" type="text" placeholder="tuweb.com" />
        </div>

        <div class="field" style="margin-top:1.1rem;">
          <label for="wc-mensaje">Cuéntanos qué te gustaría mejorar</label>
          <textarea id="wc-mensaje" name="mensaje"></textarea>
        </div>

        <div class="field-check" style="margin-top:1.2rem;">
          <input id="wc-rgpd" name="rgpd" type="checkbox" required />
          <label for="wc-rgpd">
            He leído y acepto la <a href="/politica-privacidad">política de privacidad</a>.
            Tus datos se tratan conforme al RGPD únicamente para responder a tu solicitud.
          </label>
        </div>

        <div class="form-status" data-form-status role="status"></div>

        <Button type="submit" variant="primary" class="btn-block" noMagnetic style="margin-top:1.4rem;" data-form-submit>
          {ctaFinal.cta}
        </Button>
      </form>
    </div>
  </div>
</section>

<script>
  import { safe, onReady } from "../../../scripts/utils.js";
  import { initContactForm } from "../../../scripts/effects/contact-form.js";

  onReady(() => safe(initContactForm, "initContactForm"));
</script>
