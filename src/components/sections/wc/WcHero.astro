---
import { WEB_CONVERSION } from "../../../data/web-conversion.js";
import Icon from "../../ui/Icon.astro";
import Button from "../../ui/Button.astro";

const { hero } = WEB_CONVERSION;
---

<section class="hero">
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="reveal">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1 class="h1 hero-title">{hero.title}</h1>
        <p class="lead hero-sub">{hero.subtitle}</p>

        <div class="hero-actions">
          <Button href="#auditoria" variant="primary" icon="arrow-right">Solicitar auditoría web gratuita</Button>
          <Button href="#servicios-web" variant="ghost">Ver planes de diseño web</Button>
        </div>
      </div>

      <div class="hero-visual reveal" style="transition-delay:.15s">
        <div class="wc-device-mockup" aria-hidden="true">
          <svg viewBox="0 0 500 380" xmlns="http://www.w3.org/2000/svg">
            <!-- Base del portátil -->
            <rect x="10" y="228" width="480" height="10" rx="4" style="fill:var(--ink-soft)" />
            <!-- Pantalla del portátil -->
            <rect x="30" y="15" width="340" height="213" rx="12" style="fill:var(--paper)" stroke="var(--line-strong)" stroke-width="1.5" />
            <rect x="30" y="15" width="340" height="27" rx="12" style="fill:var(--teal-100)" />
            <rect x="30" y="30" width="340" height="12" style="fill:var(--teal-100)" />
            <circle cx="45" cy="28.5" r="3.2" style="fill:var(--amber-500)" />
            <circle cx="57" cy="28.5" r="3.2" style="fill:var(--teal-500)" />
            <circle cx="69" cy="28.5" r="3.2" style="fill:var(--line-strong)" />

            <rect x="46" y="60" width="170" height="15" rx="4" style="fill:var(--ink)" opacity="0.85" />
            <rect x="46" y="82" width="130" height="8" rx="3" style="fill:var(--ink-mute)" opacity="0.5" />
            <rect x="46" y="96" width="130" height="8" rx="3" style="fill:var(--ink-mute)" opacity="0.3" />
            <rect x="46" y="116" width="78" height="24" rx="12" style="fill:var(--amber-500)" />
            <rect x="132" y="116" width="72" height="24" rx="12" fill="none" stroke="var(--line-strong)" stroke-width="1.5" />

            <rect x="250" y="58" width="100" height="112" rx="10" style="fill:var(--teal-500)" opacity="0.16" />
            <circle cx="272" cy="90" r="9" style="fill:var(--teal-600)" opacity="0.55" />
            <path d="M258 148l20-24 14 12 20-28 20 40Z" style="fill:var(--teal-600)" opacity="0.4" />

            <rect x="46" y="184" width="90" height="34" rx="8" style="fill:var(--teal-100)" />
            <rect x="146" y="184" width="90" height="34" rx="8" style="fill:var(--teal-100)" />
            <rect x="246" y="184" width="104" height="34" rx="8" style="fill:var(--teal-100)" />

            <!-- Móvil superpuesto -->
            <rect x="332" y="132" width="118" height="222" rx="22" style="fill:var(--paper)" stroke="var(--line-strong)" stroke-width="1.5" />
            <rect x="370" y="144" width="42" height="6" rx="3" style="fill:var(--ink)" opacity="0.2" />
            <rect x="348" y="166" width="86" height="12" rx="3" style="fill:var(--ink)" opacity="0.8" />
            <rect x="348" y="186" width="86" height="64" rx="8" style="fill:var(--amber-500)" opacity="0.2" />
            <path d="M356 232l14-16 10 9 14-19 14 26Z" style="fill:var(--amber-600)" opacity="0.45" />
            <rect x="348" y="262" width="86" height="7" rx="3" style="fill:var(--ink-mute)" opacity="0.45" />
            <rect x="348" y="276" width="60" height="7" rx="3" style="fill:var(--ink-mute)" opacity="0.3" />
            <rect x="348" y="298" width="86" height="26" rx="13" style="fill:var(--teal-700)" />
          </svg>
        </div>

        <div class="wc-float-chip c1 glass-card">
          <Icon name="eye" />
          {hero.floatBadges[0]}
        </div>
        <div class="wc-float-chip c2 glass-card">
          <Icon name="bolt" />
          {hero.floatBadges[1]}
        </div>
        <div class="wc-float-chip c3 glass-card">
          <Icon name="user-check" />
          {hero.floatBadges[2]}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { safe, onReady } from "../../../scripts/utils.js";
  import { initMagnetic } from "../../../scripts/effects/magnetic.js";

  onReady(() => safe(initMagnetic, "initMagnetic"));
</script>
