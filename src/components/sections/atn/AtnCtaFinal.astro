---
import { ATENCION_247 } from "../../../data/atencion-24-7.js";
import Button from "../../ui/Button.astro";

const { ctaFinal } = ATENCION_247;
---

<section class="section" id="demo">
  <div class="container">
    <div class="atn-cta-final reveal">
      <span class="eyebrow" style="color:var(--accent-ink);opacity:.75;">Demo gratuita</span>
      <h2 class="h2">{ctaFinal.title}</h2>
      <p class="lead">{ctaFinal.subtitle}</p>

      <form class="atn-cta-form" data-contact-form novalidate>
        <div class="form-grid two">
          <div class="field">
            <label for="atn-nombre">Nombre y apellidos *</label>
            <input id="atn-nombre" name="nombre" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="atn-negocio">Nombre del negocio *</label>
            <input id="atn-negocio" name="negocio" type="text" required autocomplete="organization" />
          </div>
        </div>

        <div class="form-grid two" style="margin-top:1.1rem;">
          <div class="field">
            <label for="atn-email">Email *</label>
            <input id="atn-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="atn-telefono">Teléfono</label>
            <input id="atn-telefono" name="telefono" type="tel" autocomplete="tel" />
          </div>
        </div>

        <div class="field" style="margin-top:1.1rem;">
          <label for="atn-volumen">Volumen estimado de llamadas/mes</label>
          <select id="atn-volumen" name="volumen">
            <option value="">Selecciona un rango (opcional)</option>
            <option value="menos-100">Menos de 100</option>
            <option value="100-500">100 – 500</option>
            <option value="500-1500">500 – 1.500</option>
            <option value="1500-5000">1.500 – 5.000</option>
            <option value="mas-5000">Más de 5.000</option>
          </select>
        </div>

        <div class="field" style="margin-top:1.1rem;">
          <label for="atn-mensaje">Cuéntanos cómo atiendes hoy a tus clientes</label>
          <textarea id="atn-mensaje" name="mensaje"></textarea>
        </div>

        <div class="field-check" style="margin-top:1.2rem;">
          <input id="atn-rgpd" name="rgpd" type="checkbox" required />
          <label for="atn-rgpd">
            He leído y acepto la <a href="/politica-privacidad">política de privacidad</a>.
            Tus datos se tratan conforme al RGPD únicamente para responder a tu solicitud.
          </label>
        </div>

        <div class="form-status" data-form-status role="status"></div>

        <Button type="submit" variant="primary" class="btn-block" noMagnetic style="margin-top:1.4rem;" data-form-submit>
          {ctaFinal.cta}
        </Button>
      </form>
    </div>
  </div>
</section>

<script>
  import { safe, onReady } from "../../../scripts/utils.js";
  import { initContactForm } from "../../../scripts/effects/contact-form.js";

  onReady(() => safe(initContactForm, "initContactForm"));
</script>
