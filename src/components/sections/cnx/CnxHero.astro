---
import { CONECTIVIDAD } from "../../../data/conectividad.js";
import Icon from "../../ui/Icon.astro";
import Button from "../../ui/Button.astro";
import Photo from "../../ui/Photo.astro";
import heroPhoto from "../../../assets/img/telecomunicaciones-fibra.jpg";

const { hero } = CONECTIVIDAD;
---

<section class="hero">
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="reveal">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1 class="h1 hero-title">{hero.title}</h1>
        <p class="lead hero-sub">{hero.subtitle}</p>

        <div class="hero-actions">
          <Button href="#presupuesto" variant="primary" icon="arrow-right">Solicitar presupuesto</Button>
          <Button href="#servicios-conectividad" variant="ghost">Ver equipamiento disponible</Button>
        </div>
      </div>

      <div class="hero-visual reveal" style="transition-delay:.15s">
        <div class="hero-photo-frame">
          <Photo
            src={heroPhoto}
            alt="Cables de fibra óptica iluminados, representando la infraestructura de telecomunicaciones propia"
            eager
            quality={85}
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>

        <div class="cnx-hero-chip glass-card">
          <Icon name="wifi" />
          {hero.chip}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { safe, onReady } from "../../../scripts/utils.js";
  import { initMagnetic } from "../../../scripts/effects/magnetic.js";

  onReady(() => safe(initMagnetic, "initMagnetic"));
</script>
